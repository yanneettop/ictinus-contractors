# Cloudflare Pages Functions only. Never prefix these values with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_key
ICTINUS_INTEGRATION_API_KEY=replace_with_a_long_random_bearer_key
OPENAI_API_KEY=sk-replace_with_your_server_side_key
OPENAI_CHAT_MODEL=gpt-5.6-luna
GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8788/api/google-calendar/callback
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
